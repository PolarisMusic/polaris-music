# Frontend Environment Configuration

# Backend API Configuration
# IMPORTANT: VITE_API_URL must include the /api prefix
# For local development with backend running locally: use :3001/api
# For Docker Compose stack: use :3000/api
VITE_API_URL=http://localhost:3001/api
VITE_GRAPHQL_URL=http://localhost:3001/graphql

# Chain Profile — selects preset defaults for chain ID + RPC URL
# Values: jungle4 | local | mainnet
# When set, VITE_CHAIN_ID and VITE_RPC_URL default to the preset values.
# You can still override individually with the vars below.
#
# REQUIRED in production builds. The frontend will refuse to start a
# `npm run build` artifact when neither VITE_CHAIN_PROFILE nor the
# legacy alias VITE_CHAIN_MODE is set, to prevent silent fallback to
# the testnet preset.
#
# In `npm run dev` it's optional: when unset, the dev server defaults
# to "jungle4" and prints a single warning.
VITE_CHAIN_PROFILE=jungle4
# Legacy alias — accepted for backwards compatibility. Prefer
# VITE_CHAIN_PROFILE in new configs.
# VITE_CHAIN_MODE=jungle4

# Resource Provider — who pays a visitor's CPU and NET
#
# Antelope bills the first authorizer of a transaction. A resource provider
# prepends its own signed no-op action so the bill lands on it instead of on
# the visitor, while the visitor's own signature on their own actions is
# untouched. Nothing needs setting here: jungle4 and mainnet builds point at
# Greymass's public service by default, and a local chain has no provider.
#
# This does NOT cover RAM. RAM is billed inside the contract at the emplace
# call, which names the payer; see docs/13-user-onboarding.md.
#
# Turn it off entirely:
# VITE_RESOURCE_PROVIDER=off
#
# Point at a provider of our own, once one exists:
# VITE_RESOURCE_PROVIDER_URL=https://api.polaris.mu
#
# Allow the provider's paid tier. OFF by default and deliberately so: the paid
# tier asks a brand-new visitor to hand over tokens mid-transaction, which is
# the moment they decide this is a scam. With fees off, a visitor past the free
# tier simply pays their own way, which is a worse transaction and a better
# first impression.
# VITE_RESOURCE_PROVIDER_ALLOW_FEES=true
# VITE_RESOURCE_PROVIDER_MAX_FEE=0.5000 EOS

# Blockchain Configuration
# These override the chain-mode preset when explicitly set
# For local nodeos: see contracts/README.md "Testing Locally"
# For EOS mainnet: set VITE_CHAIN_MODE=mainnet (or override below)
VITE_CHAIN_ID=73e4385a2708e6d7048834fbc1079f2fabb17b3c125b146af438971e90716c4d
VITE_RPC_URL=https://jungle4.greymass.com
VITE_CONTRACT_ACCOUNT=polarismusic

# Ingestion Mode — controls how events reach the graph database
# dev: UI calls /api/ingest/anchored-event directly after tx (fast feedback)
# chain: UI broadcasts tx only; Substreams/SHiP sink handles ingestion
# Default: dev (UI-triggered ingestion)
VITE_INGEST_MODE=dev

# ABI Provider Configuration
# When true: Use local ABI fallback (dev/testnet resilience)
# When false: WharfKit fetches ABI from deployed contract (production)
# Default: true for development
VITE_USE_LOCAL_ABI=true
